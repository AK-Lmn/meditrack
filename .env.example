# Neon provides DATABASE_URL through the connected integration.
DATABASE_URL=

# Generate a random value with at least 32 characters.
BETTER_AUTH_SECRET=

# Optional stable canonical URL. Preview URLs are detected automatically.
BETTER_AUTH_URL=

# QStash Configuration (for scheduled background reminders)
# Find these in your Upstash Console: https://console.upstash.com/qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Browser Web Push configuration.
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
